DEEPSEEK_API_KEY=replace-me
GITHUB_TOKEN=replace-me

# 生产环境必须配置；可用逗号分隔多个 Key。客户端使用 Authorization: Bearer <key>。
REPOMIND_API_KEYS=replace-with-a-long-random-key
REPOMIND_MAX_ACTIVE_JOBS=4
REPOMIND_JOB_DB=repo_knowledge_base/api_jobs.sqlite

# Linux 只有明确接受“仅进程资源限制”时才启用；推荐安装 bubblewrap，保持 false。
REPOMIND_ALLOW_UNSANDBOXED_TESTS=false
